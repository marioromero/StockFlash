# StockFlash - Git exclusions
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Dependencias
/vendor/
/node_modules/
/.opencode/node_modules/

# Archivos locales
/.idea/
/.phpunit.cache/
.phpunit.result.cache
/coverage/
*.log
*.sqlite

# Laravel
/public/build/
/public/hot
/public/storage
/storage/*.key

# INSTALL-001: tiendas file locales de pruebas/instalador (nunca repo fuente)
/storage/framework/install-sessions/
/storage/framework/testing/

# BOOT-001 scaffold temporal (ignorar hasta fusión revisada)
/tmp-boot-001/
docs/work/.run/

# Artefactos locales de despliegue (transferencia, nunca repo fuente)
/stockflash-staging-release.zip
/stockflash-staging-part-*.zip
scripts/__pycache__/
tests/harness/__pycache__/
/sf-probe-*.txt
/sf-probe-*.zip
/.probe-*.txt
/.probe-*.zip
/.env.staging-new
/.sf-env-new
/.sf-env-fixed
/.sf-php-probe-*.php
