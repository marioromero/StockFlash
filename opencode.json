{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*secrets*": "deny"
    },
    "edit": {
      "*": "allow",
      "docs/product/*": "deny",
      "docs/governance/CONSTITUTION.md": "deny",
      "docs/branding/brand-contract.md": "deny",
      "docs/branding/module-identity-map.md": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "bash": {
      "*": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current": "allow",
      "opencode --version": "allow",
      "php -v": "allow",
      "composer --version": "allow",
      "node --version": "allow",
      "npm --version": "allow",
      "git push*": "deny",
      "git commit*": "deny",
      "git tag*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "ftp *": "deny",
      "lftp *": "deny",
      "mysql *": "deny",
      "mariadb *": "deny",
      "php artisan migrate*": "deny",
      "php artisan db:*": "deny",
      "php artisan tinker*": "deny",
      "py -3 scripts/safe_git_pull.py": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git fetch origin main": "allow",
      "git check-ignore*": "allow",
      "git hash-object*": "allow",
      "git ls-remote origin main": "allow",
      "git show*": "allow",
      "git merge-base*": "allow",
      "composer validate*": "allow",
      "php artisan test": "allow",
      "npm run build": "allow",
      "py -3 scripts/sf_verify.py*": "allow",
      "Test-Path *": "allow",
      "Get-Item *": "allow",
      "Get-ChildItem *": "allow",
      "Select-Object *": "allow",
      "Format-Table *": "allow",
      "echo *": "allow",
      "Remove-Item*": "deny",
      "Clear-Content*": "deny",
      "Remove-ItemProperty*": "deny",
      "del *": "deny",
      "erase *": "deny",
      "rmdir *": "deny",
      "rd *": "deny",
      "git add*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": {
      "*publisher*": "deny",
      "*orchestrator*": "deny",
      "stockflash-orchestrator": "allow"
    }
  },
  "agent": {
    "stockflash-publisher": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git ls-files*": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "git remote get-url origin": "allow",
          "git rev-parse*": "allow",
          "git merge-base*": "allow",
          "git check-ignore*": "allow",
          "git hash-object*": "allow",
          "git ls-remote*": "allow",
          "git show*": "allow",
          "git fetch origin main": "allow",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git add -- *": "allow",
          "git commit -m *": "allow",
          "git push origin main": "allow",
          "git add -- .": "deny",
          "git add -- ./": "deny"
        },
        "task": {
          "*": "deny",
          "stockflash-orchestrator": "deny",
          "*orchestrator*": "deny"
        },
        "external_directory": "deny"
      }
    },
    "stockflash-implementer": {
      "permission": {
        "bash": {
          "git commit*": "deny",
          "git push*": "deny"
        },
        "task": {
          "stockflash-publisher": "deny",
          "*publisher*": "deny",
          "stockflash-orchestrator": "deny",
          "*orchestrator*": "deny"
        },
        "edit": {
          "*": "allow",
          "app/*": "allow",
          "bootstrap/*": "allow",
          "config/*": "allow",
          "database/*": "allow",
          "resources/*": "allow",
          "routes/*": "allow",
          "tests/*": "allow",
          "scripts/*": "allow",
          "public/images/brand/*": "allow",
          "docs/work/*": "allow",
          "docs/harness/*": "allow",
          ".opencode/commands/sf-run.md": "allow",
          ".opencode/agents/stockflash-orchestrator.md": "allow",
          ".gitignore": "allow",
          "docs/work/features/*": "allow",
          ".opencode/agents/stockflash-publisher.md": "deny",
          ".opencode/commands/sf-publish.md": "deny",
          "docs/product/*": "deny",
          "docs/governance/CONSTITUTION.md": "deny",
          "docs/branding/brand-contract.md": "deny",
          "docs/branding/module-identity-map.md": "deny",
          "AGENTS.md": "deny",
          "opencode.json": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.pem": "deny",
          "*.key": "deny"
        }
      },
      "mode": "all"
    },
    "stockflash-reviewer": {
      "permission": {
        "bash": {
          "git commit*": "deny",
          "git push*": "deny",
          "Test-Path *": "allow",
          "Get-Item *": "allow",
          "Get-ChildItem *": "allow",
          "Select-Object *": "allow",
          "Format-Table *": "allow",
          "echo *": "allow",
          "Remove-Item*": "deny",
          "Clear-Content*": "deny",
          "Remove-ItemProperty*": "deny",
          "del *": "deny",
          "erase *": "deny",
          "rmdir *": "deny",
          "rd *": "deny"
        },
        "task": {
          "stockflash-publisher": "deny",
          "*publisher*": "deny",
          "stockflash-orchestrator": "deny",
          "*orchestrator*": "deny"
        }
      }
    },
    "stockflash-orchestrator": {
      "description": "Coordina Feature Packets aprobadas, gates, QA y publicación por agentes separados.",
      "mode": "all",
      "permission": {
        "edit": {
          "*": "deny",
          "docs/work/.run/*": "allow"
        },
        "bash": {
          "*": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git ls-files*": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "git rev-parse*": "allow",
          "git fetch origin main": "allow",
          "git ls-remote origin main": "allow",
          "git check-ignore*": "allow",
          "git hash-object*": "allow",
          "git show*": "allow",
          "git merge-base*": "allow",
          "composer validate*": "allow",
          "php -v": "allow",
          "php artisan test": "allow",
          "composer --version": "allow",
          "node --version": "allow",
          "npm --version": "allow",
          "npm run build": "allow",
          "py -3 scripts/safe_git_pull.py": "allow",
          "py -3 scripts/sf_verify.py*": "allow",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "git checkout -*": "deny",
          "git branch -D*": "deny",
          "git tag*": "deny",
          "ssh *": "deny",
          "scp *": "deny",
          "sftp *": "deny",
          "ftp *": "deny",
          "lftp *": "deny",
          "mysql *": "deny",
          "mariadb *": "deny",
          "php artisan migrate*": "deny",
          "php artisan db:*": "deny",
          "php artisan tinker*": "deny",
          "rm *": "deny",
          "Test-Path *": "allow",
          "Get-Item *": "allow",
          "Get-ChildItem *": "allow",
          "Select-Object *": "allow",
          "Format-Table *": "allow",
          "echo *": "allow",
          "Remove-Item*": "deny",
          "Clear-Content*": "deny",
          "Remove-ItemProperty*": "deny",
          "del *": "deny",
          "erase *": "deny",
          "rmdir *": "deny",
          "rd *": "deny"
        },
        "task": {
          "*": "deny",
          "stockflash-implementer": "allow",
          "stockflash-reviewer": "allow",
          "stockflash-publisher": "allow"
        },
        "external_directory": "deny"
      }
    },
    "build": {
      "permission": {
        "task": {
          "*publisher*": "deny",
          "*orchestrator*": "deny",
          "stockflash-orchestrator": "allow"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "default_agent": "build",
  "subagent_depth": 2
}
