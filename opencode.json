{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*secrets*": "deny"
    },
    "edit": {
      "*": "ask",
      "docs/product/*": "deny",
      "docs/governance/CONSTITUTION.md": "deny",
      "docs/branding/brand-contract.md": "deny",
      "docs/branding/module-identity-map.md": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current": "allow",
      "opencode --version": "allow",
      "php -v": "allow",
      "composer --version": "allow",
      "node --version": "allow",
      "npm --version": "allow",
      "git push*": "deny",
      "git commit*": "deny",
      "git tag*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "ftp *": "deny",
      "lftp *": "deny",
      "mysql *": "deny",
      "mariadb *": "deny",
      "php artisan migrate*": "deny",
      "php artisan db:*": "deny",
      "php artisan tinker*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  }
}
